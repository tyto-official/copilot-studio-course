{
  "name": "t-berg-du",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n WEB,API -c green,blue \"next dev\" \"tsx watch server/index.ts\"",
    "build": "next build",
    "build:web": "next build",
    "build:api": "tsc -p tsconfig.server.json",
    "build:containers": "npm run build:web && npm run build:api",
    "start": "next start",
    "start:web": "next start",
    "start:api": "tsx server/index.ts",
    "start:api:compiled": "node dist-api/server/index.js",
    "test:local": "tsx server/test-client.ts",
    "demo:all": "tsx server/demo-client.ts --mode all",
    "demo:connector": "tsx server/demo-client.ts --mode connector",
    "demo:mcp": "tsx server/demo-client.ts --mode mcp",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-api --ignore-pattern .next"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.13.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "next": "^16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.5",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  },
  "type": "module"
}
